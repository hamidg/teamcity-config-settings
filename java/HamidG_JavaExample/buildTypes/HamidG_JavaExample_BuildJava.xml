<?xml version="1.0" encoding="UTF-8"?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build_Java</name>
  <description />
  <settings>
    <options>
      <option name="checkoutDirectory" value="%env.TEAMCITY_BUILDCONF_NAME%-%build.number%" />
      <option name="cleanBuild" value="true" />
    </options>
    <build-runners>
      <runner id="simpleRunner" name="Compile Clas" type="simpleRunner">
        <parameters>
          <param name="script.content"><![CDATA[#!/bin/bash
echo "Compile Class"
javac HelloWorld/Main.java
echo "Job completed"]]></param>
          <param name="teamcity.kubernetes.executor.pull.policy" value="IfNotPresent" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Run_Class" name="Run Class" type="simpleRunner">
        <parameters>
          <param name="script.content"><![CDATA[#!/bin/bash
echo "Run class"
java -cp . HelloWorld.Main]]></param>
          <param name="teamcity.kubernetes.executor.pull.policy" value="IfNotPresent" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Create_JAR_file" name="Create JAR file" type="simpleRunner">
        <parameters>
          <param name="script.content"><![CDATA[#!/bin/bash
echo "Creating the jar file"
jar cfme Main.jar Manifest.txt HelloWorld.Main HelloWorld/Main.class]]></param>
          <param name="teamcity.kubernetes.executor.pull.policy" value="IfNotPresent" />
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
      <runner id="Run_JAR_file" name="Run JAR file" type="simpleRunner">
        <parameters>
          <param name="script.content"><![CDATA[#!/bin/bash
echo "Running the jar file"
ls -l
java -jar Main.jar
# echo ${'$'}PWD]]></param>
          <param name="teamcity.step.mode" value="default" />
          <param name="use.custom.script" value="true" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="HamidG_JavaExample_Java" />
    </vcs-settings>
  </settings>
</build-type>

